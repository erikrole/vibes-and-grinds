PORT=3001
DATABASE_URL=postgresql://username:password@localhost:5432/vibes_and_grinds

# For local development with SQLite (easier to get started)
# Comment out DATABASE_URL above and uncomment this:
# USE_SQLITE=true

# Optional: override Warren Nolan NET source with your own worker/feed URL
NET_RANKINGS_URL=https://www.warrennolan.com/basketball/2026/net

# Write protection.
# Production: set WRITE_KEY in Cloudflare Pages Functions secrets to a long
# random value (`openssl rand -hex 32`). Do not commit the real secret, and
# do not reuse an example string — keys shorter than 16 characters or equal
# to a known placeholder are treated as unset.
# WRITE_KEY=
# Local-only escape hatch when WRITE_KEY is unset. Never enable in production.
ALLOW_INSECURE_WRITES=true
