PORT=3001
# Local storage is SQLite, created in the backend working directory.

# Optional public, domain-restricted MapKit JS token. Never use a private signing key.
APPLE_MAPS_TOKEN=
# Optional fallback Places lookup when Apple Maps is not configured.
GOOGLE_MAPS_API_KEY=

# Optional: override Warren Nolan NET source with your own worker/feed URL
NET_RANKINGS_URL=https://www.warrennolan.com/basketball/2026/net
