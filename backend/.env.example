# Backend (Express server, used for local development).
#
# In production the API is served by Cloudflare Pages Functions, not this
# Express server. See DEPLOYMENT.md for the production environment.

# Port the server listens on.
PORT=3001

# Optional: override the Warren Nolan NET feed URL. Leave unset to use the
# default in shared/constants.js. Useful if you front the feed with your
# own Cloudflare Worker.
NET_RANKINGS_URL=

# Required for the /api/places-* endpoints. The Express server forwards user
# input to the Google Places API (New) using this key. Get one from
# https://console.cloud.google.com/ → APIs & Services → Credentials, and
# enable both "Places API (New)" and billing on the project.
GOOGLE_MAPS_API_KEY=
