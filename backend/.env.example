PORT=3001
# Exact browser frontend origin; 127.0.0.1 and localhost are different origins.
LOCAL_ORIGIN=http://localhost:3000
# SHA-256 of a generated 256-bit owner access key, never a human password.
OWNER_KEY_HASH=
# Optional isolated storage paths; defaults remain local to the backend.
# DATABASE_PATH=/absolute/path/journal.sqlite
# UPLOAD_DIR=/absolute/path/photos
# Local storage is SQLite, created in the backend working directory.

# Optional public, domain-restricted MapKit JS token. Never use a private signing key.
APPLE_MAPS_TOKEN=
# Optional fallback Places lookup when Apple Maps is not configured.
GOOGLE_MAPS_API_KEY=

# Optional: override Warren Nolan NET source with your own worker/feed URL
NET_RANKINGS_URL=https://www.warrennolan.com/basketball/2026/net
