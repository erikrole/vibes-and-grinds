VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# For local development only - leave empty for production
VITE_API_URL=http://localhost:3001

# Optional: direct NET feed URL (frontend falls back to /api/vest/net-rankings)
VITE_NET_RANKINGS_URL=

# Optional convenience: bake the write key into the client build.
# Must match server WRITE_KEY. Leave unset in production so the secret is
# not shipped in the public JS bundle; the UI prompts once and stores it
# in localStorage after a successful save.
# VITE_WRITE_KEY=
