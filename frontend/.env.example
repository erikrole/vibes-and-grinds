# Frontend env (Vite). All variables MUST be prefixed with VITE_ to be
# exposed to the browser. Variables without that prefix are ignored.

# Required: Google Maps JS API key, used for the autocomplete / map widgets.
# In production, restrict this key to your domain in the Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend base URL.
# - Local dev: point at the Express server (`http://localhost:3001`).
# - Production (Cloudflare Pages): leave empty so the frontend uses
#   relative `/api/...` URLs and hits the Pages Functions in-place.
VITE_API_URL=http://localhost:3001

# Optional: bypass /api/vest/net-rankings and call a NET feed worker
# directly. Leave empty to use the proxy at /api/vest/net-rankings.
VITE_NET_RANKINGS_URL=
