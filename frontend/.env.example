VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# For local development only - leave empty for production
VITE_API_URL=http://localhost:3001

# Optional: direct NET feed URL (frontend falls back to /api/vest/net-rankings)
VITE_NET_RANKINGS_URL=

# Optional convenience: bake the write key into the client build.
# Must match server WRITE_KEY. Prefer prompting + localStorage in production
# so the secret is not shipped in the public JS bundle.
# VITE_WRITE_KEY=change-me-to-a-long-random-secret
